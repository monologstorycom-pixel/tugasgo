{
  "expo": {
    "name": "TugasGo",
    "slug": "tugasgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tugasgo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rsby.tugasgo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TugasGo memerlukan akses lokasi untuk pelacakan tugas pengantaran.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TugasGo memerlukan akses latar belakang agar tracking rute driver tetap berjalan saat layar mati.",
        "NSCameraUsageDescription": "TugasGo memerlukan kamera untuk bukti foto penyelesaian tugas."
      }
    },
    "android": {
      "package": "com.rsby.tugasgo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan TugasGo mengakses lokasi driver setiap saat untuk pelacakan tugas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan akses foto untuk upload bukti tugas."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d81dc23-0b40-4ba8-994f-bc1841b62f4b"
      }
    }
  }
}
